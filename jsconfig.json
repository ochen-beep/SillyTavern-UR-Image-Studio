{
    "compilerOptions": {
        "checkJs": true,
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Node",
        "allowJs": true,
        "noEmit": true,
        "strict": false,
        "skipLibCheck": true
    },
    "include": ["src/**/*.js", "tests/**/*.js", "index.js"]
}
