.worktrees/

# dependencies
node_modules/

# AI agent workspace data
.zcode/

# project docs (kept local, not part of the extension)
docs/

# temp scratch & test output
tmp/
tmp_*
*.log
.nano-*
gui-test-screenshots/

# OS junk
Thumbs.db
Desktop.ini
.DS_Store

# patch/editor conflict leftovers
*.orig
*.rej
*.bak

# local secrets (should never exist here; guard anyway)
.env
.env.*

# cloud-sync conflict leftovers (Nextcloud/Dropbox style)
*.sync-conflict-*
.superpowers/

